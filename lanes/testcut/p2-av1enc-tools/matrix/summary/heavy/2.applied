mutant 2: crates/ec-av1/src/mvstack.rs:2227:5 'let side_slots = |side: usize| -> [(i32, i32); 2] {\n        let merged: Vec<(i32, i32)> = lists.ref_id[side]\n            .iter()\n            .chain(lists.ref_diff[side].iter())\n            .take(2)\n            .copied()\n            .collect();\n        std::array::from_fn(|i| {\n            merged.get(i).copied().unwrap_or_else(|| {\n                if gm_mv_candidates[side] != (0, 0) {\n                    hit!(COMP_GM_FILL_HITS);\n                }\n                gm_mv_candidates[side]\n            })\n        })\n    };\n    let side0 = side_slots(0);\n    let side1 = side_slots(1);\n    [(side0[0], side1[0]), (side0[1], side1[1])]' -> '[((1, 1), (-1, 0)); 2]'
